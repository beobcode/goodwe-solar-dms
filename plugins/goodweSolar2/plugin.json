{
    "id": "goodweSolar2",
    "name": "GoodWe Solar & Battery",
    "description": "Real-time local GoodWe inverter telemetry, battery status, power flow, and fault monitor",
    "version": "1.2.0",
    "author": "Dominik",
    "type": "composite",
    "capabilities": ["dankbar-widget", "control-center", "dash-card", "dash-tab", "monitoring"],
    "components": {
        "widget": "./GoodWeSolarWidget.qml",
        "dashCard": "./GoodWeSolarDashCard.qml",
        "dash": "./GoodWeSolarDashTab.qml"
    },
    "dash": {
        "title": "Solar",
        "icon": "solar_power",
        "card": {
            "title": "GoodWe Solar",
            "icon": "solar_power",
            "w": 2,
            "h": 2,
            "minW": 1,
            "minH": 1,
            "maxW": 4,
            "maxH": 3
        },
        "options": [
            {
                "key": "tone",
                "text": "Tone",
                "type": "choice",
                "def": "",
                "choices": [
                    { "value": "", "text": "Surface" },
                    { "value": "primary", "text": "Primary" },
                    { "value": "secondary", "text": "Secondary" },
                    { "value": "tertiary", "text": "Tertiary" }
                ]
            }
        ]
    },
    "icon": "solar_power",
    "settings": "./GoodWeSolarSettings.qml",
    "requires_dms": ">=2.0.0",
    "permissions": [
        "settings_read",
        "settings_write"
    ]
}
